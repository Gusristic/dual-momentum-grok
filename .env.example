# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # solo server · NUNCA NEXT_PUBLIC_*

# ─── Datos (solo fuentes gratuitas) ─────────────────────────
# Yahoo Finance vía yfinance (sin key)
# Stooq (sin key)
# OpenFIGI: sin key → límite 25 req/min
# Morningstar / QueFondos / CNMV / FT: scraping controlado

# ─── Cron ───────────────────────────────────────────────────
CRON_SECRET=                     # random string para validar scheduled functions

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
